# ---- Network ---------------------------------------------------------------
# local | testnet. Contract ids are read from deployments/<network>.json.
STELLAR_NETWORK=local
# Optional RPC override (server-side and indexer).
STELLAR_RPC_URL=

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgres://veridia:veridia@localhost:5544/veridia

# ---- Private object storage (S3-compatible) ---------------------------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=veridia-evidence
S3_ACCESS_KEY_ID=veridia-dev-access
S3_SECRET_ACCESS_KEY=veridia-dev-secret-change-me
S3_FORCE_PATH_STYLE=true

# ---- Auth -------------------------------------------------------------------
# HS256 secret for session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ---- Indexer ----------------------------------------------------------------
INDEXER_POLL_MS=2000
INDEXER_RECONCILE_EVERY=15

# ---- E2E only: enables an injected test wallet in the browser. NEVER in prod. --
NEXT_PUBLIC_E2E_TEST_WALLET=0
