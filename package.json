{
  "name": "veridia",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @veridia/web dev",
    "build": "pnpm --filter @veridia/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "test:contracts": "cd contracts && cargo test",
    "test:e2e": "pnpm --filter @veridia/web test:e2e",
    "contracts:build": "cd contracts && stellar contract build",
    "infra:up": "docker compose --profile stellar up -d",
    "infra:down": "docker compose --profile stellar down",
    "db:migrate": "pnpm --filter @veridia/web db:migrate",
    "db:generate": "pnpm --filter @veridia/web db:generate",
    "deploy:local": "tsx scripts/deploy.ts --network local",
    "deploy:testnet": "tsx scripts/deploy.ts --network testnet",
    "seed:local": "tsx scripts/seed.ts --network local",
    "indexer": "pnpm --filter @veridia/indexer start"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
